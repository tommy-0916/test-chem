{
  "文献题目": "Defect-Free Potassium Manganese Hexacyanoferrate Cathode Material for High-Performance Potassium-Ion Batteries",
  "1. 解决的问题": "该文针对 KxMn[Fe(CN)6] 类正极中普遍存在的 [Fe(CN)6] 空位、结晶水过多以及 K 缺位问题，这些因素会诱发副反应、Mn 溶解和循环不稳定。作者目标是制备缺陷更少、结构更完整的 KMnHCF 正极，以同时提升高电压、能量密度和循环寿命。",
  "2. 具体的合成步骤": {
    "描述性总结": "作者在室温和 N2 鼓泡条件下采用 EDTA-2K 辅助的液相共沉淀法制备 KMnHCF。先配制 50 mL 0.04 M Mn(CH3COO)2.4H2O 与 0.04 M EDTA-2K.4H2O 混合溶液，然后在持续磁力搅拌和 N2 鼓泡下，将其在 10 min 内逐滴加到 50 mL 0.04 M K4Fe(CN)6.3H2O 溶液中。反应完成后静置老化 4 h，再离心、去离子水洗涤数次，最后在 80°C 真空条件下干燥 10 h。",
    "参数列表": [
      {
        "步骤序号": 1,
        "操作": "配制 Mn/EDTA 溶液",
        "试剂/对象": "Mn(CH3COO)2.4H2O + EDTA-2K.4H2O",
        "参数": "50 mL; 0.04 M Mn(CH3COO)2.4H2O + 0.04 M EDTA-2K.4H2O"
      },
      {
        "步骤序号": 2,
        "操作": "配制铁氰化物溶液",
        "试剂/对象": "K4Fe(CN)6.3H2O",
        "参数": "50 mL; 0.04 M"
      },
      {
        "步骤序号": 3,
        "操作": "滴加反应",
        "试剂/对象": "将 Mn/EDTA 溶液加入 K4Fe(CN)6 溶液",
        "参数": "dropwise within 10 min; room temperature; continuous magnetic stirring; N2 bubbling"
      },
      {
        "步骤序号": 4,
        "操作": "静置老化",
        "试剂/对象": "反应体系",
        "参数": "4 h; without stirring"
      },
      {
        "步骤序号": 5,
        "操作": "离心与洗涤",
        "试剂/对象": "KMnHCF 产物",
        "参数": "去离子水洗涤数次"
      },
      {
        "步骤序号": 6,
        "操作": "真空干燥",
        "试剂/对象": "KMnHCF 产物",
        "参数": "80 C; 10 h"
      }
    ]
  },

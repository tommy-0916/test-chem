{
  "文献题目": "Ultrafast Aqueous Potassium-Ion Batteries Cathode for Stable Intermittent Grid-Scale Energy Storage",
  "普鲁士蓝样品": {
    "样品名称": "NiFC-porous",
    "化学式": "K2NiFe(CN)6·1.2H2O"
  },
  "1. 解决的问题": "该文针对间歇性电网储能对秒级响应、高功率、长寿命和高能量效率的需求，尝试解决水系钾离子电池尚不能超快储钾的问题。作者认为传统 PBA 共沉淀过程中粒径和形貌难控，同时 K+ 半径较大也容易造成结构应力。因此文章通过构建富钾介孔镍亚铁氰化物，以兼顾超高倍率、长循环和高往返能量效率。",
  "2. 具体的合成步骤": {
    "描述性总结": "作者采用扩散诱导共沉淀法制备 NiFC-porous。先将 3 mmol K4Fe(CN)6·10H2O 和 12 g KCl 加入 150 mL 水中搜拌 10 min 得到溶液 A，再将 6 mmol NiCl2·6H2O 加入另一份 150 mL 水中搜拌 10 min 得到溶液 B。之后在 75 °C 下将 A 缓慢滴加到 B 中，老化 24 h 形成沉淀，最后过滤、用去离子水和乙醇多次洗涤，在 60 °C 真空烘箱中过夜干燥。对照样品 NiFC-cube 的唯一区别是将 12 g KCl 替换为 12 g 柠檬酸钾。",
    "参数列表": [
      {
        "步骤序号": 1,
        "操作": "配制溶液 A",
        "试剂/对象": "K4Fe(CN)6·10H2O + KCl",
        "参数": "3 mmol + 12 g；150 mL 水；搜拌 10 min",
        "来源": "正文 Experimental Section 528-542 行"
      },
      {
        "步骤序号": 2,
        "操作": "配制溶液 B",
        "试剂/对象": "NiCl2·6H2O",
        "参数": "6 mmol；150 mL 水；搜拌 10 min",
        "来源": "正文 Experimental Section 540-542 行"
      },
      {
        "步骤序号": 3,
        "操作": "滴加反应",
        "试剂/对象": "将 A 加入 B",
        "参数": "75 °C；磁搜拌；滴加时间未明确给出",
        "来源": "正文 Experimental Section 542-543 行"
      },
      {
        "步骤序号": 4,
        "操作": "老化",
        "试剂/对象": "混合反应体系",
        "参数": "24 h",
        "来源": "正文 Experimental Section 543-544 行"
      },
      {
        "步骤序号": 5,
        "操作": "过滤与洗涤",
        "试剂/对象": "去离子水 + 乙醇",
        "参数": "多次洗涤；次数未明确给出",
        "来源": "正文 Experimental Section 544-545 行"
      },
      {
        "步骤序号": 6,
        "操作": "真空干燥",
        "试剂/对象": "NiFC-porous",
        "参数": "60 °C；过夜",
        "来源": "正文 Experimental Section 545-546 行"
      },
      {
        "步骤序号": 7,
        "操作": "对照样品",
        "试剂/对象": "NiFC-cube",
        "参数": "12 g KCl 替换为 12 g potassium citrate",
        "来源": "正文 Experimental Section 546-548 行"
      }
    ]
  },
  "3. 性能": [
    {

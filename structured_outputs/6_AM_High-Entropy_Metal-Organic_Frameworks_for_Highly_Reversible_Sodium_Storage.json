{
  "文献题目": "High-Entropy Metal-Organic Frameworks for Highly Reversible Sodium Storage",
  "1. 解决的问题": "该文针对 PBA 基材料在钠离子储存中易发生不可逆相变、气体副反应和可逆性不足的问题。作者通过构建高熵 PBA 及其衍生体，目标是抑制结构崩解和相变幅度，从而获得更高的钠储存可逆性与长周期库仑效率。",
  "2. 具体的合成步骤": {
    "描述性总结": "作者采用同步滴加的水相共沉淀法制备 HE-PBA 前驱体。先将 4 mmol Na4Fe(CN)6 和 15 g NaCl 溶于 200 mL 去离子水中形成 A 液，再将 FeCl2.4H2O、MnCl2.4H2O、NiCl2.6H2O、CuCl2.2.5H2O、CoCl2.6H2O 各 0.5 mmol 溶于 200 mL 水中形成 B 液。将 A 与 B 液在磁力搅拌下同时缓慢加入 500 mL 去离子水中，继续搅拌 2 h，然后老化 24 h，再离心、用去离子水洗涤数次，最后在 60°C 下过夜干燥。",
    "参数列表": [
      {
        "步骤序号": 1,
        "操作": "配制 A 液",
        "试剂/对象": "Na4Fe(CN)6 + NaCl",
        "参数": "4 mmol Na4Fe(CN)6 + 15 g NaCl in 200 mL deionized water"
      },
      {
        "步骤序号": 2,
        "操作": "配制 B 液",
        "试剂/对象": "FeCl2.4H2O + MnCl2.4H2O + NiCl2.6H2O + CuCl2.2.5H2O + CoCl2.6H2O",
        "参数": "0.5 mmol each in 200 mL water"
      },
      {
        "步骤序号": 3,
        "操作": "同时缓慢滴加",
        "试剂/对象": "将 A 和 B 液加入 500 mL 去离子水",
        "参数": "磁力搅拌条件下缓慢加入"
      },
      {
        "步骤序号": 4,
        "操作": "搅拌反应",
        "试剂/对象": "混合体系",
        "参数": "2 h"
      },
      {
        "步骤序号": 5,
        "操作": "老化",
        "试剂/对象": "反应产物",
        "参数": "24 h"
      },
      {
        "步骤序号": 6,
        "操作": "离心与洗涤",
        "试剂/对象": "HE-PBA 产物",
        "参数": "去离子水洗涤数次"
      },
      {
        "步骤序号": 7,
        "操作": "干燥",
        "试剂/对象": "HE-PBA 产物",
        "参数": "60 C; overnight"
      }
    ]
  },
  "3. 性能": [
    {
      "序号": 1,
      "指标": "比能量",
      "数值": "378 Wh kg^-1",
      "条件": "钠离子储存体系"
    },
    {
      "序号": 2,
      "指标": "长循环后容量",
      "数值": "68 mAh g^-1",
      "条件": "0.5 A g^-1; after 3000 cycles"
    },
    {
      "序号": 3,
      "指标": "库仑效率",
      "数值": "nearly 100%",
      "条件": ">3000 cycles"
    },
    {
      "序号": 4,
      "指标": "Na+ 脱嵌扩散系数",
      "数值": "2.07 x 10^-8 cm^2 s^-1",
      "条件": "脱钠过程"
    },
    {
      "序号": 5,
      "指标": "Na+ 嵌入扩散系数",
      "数值": "9.75 x 10^-9 cm^2 s^-1",
      "条件": "储钠过程"
    }
  ]
}

{
  "文献题目": "Fe-Substituted KMnF for Aqueous Potassium-Ion Batteries",
  "1. 解决的问题": "该文针对 KMnF 类锰基普鲁士蓝正极在水系 K 离子电池中存在的 Mn 溶解、Jahn-Teller 畸变和循环中容量快速衰减问题。作者利用改性电解液诱导 KMnF 表面原位 Fe 取代，以稳定结构、提升反应可逆性和循环寿命。",
  "2. 具体的合成步骤": {
    "描述性总结": "作者采用柠檬酸钃辅助的液相共沉淀法制备 KMnF 前驱体。先将 6 mmol K4Fe(CN)6.3H2O 溶于 200 mL 去离子水中，再将 6 mmol MnSO4.H2O 和 8 g potassium citrate 溶于另外 200 mL 去离子水中。将 MnSO4 溶液缓慢加入前者后，在 60°C 下搅拌 12 h，然后继续在 60°C 下老化 24 h，最后离心、用去离子水和酒精各洗涤 3 次，并在 80°C 真空条件下干燥。",
    "参数列表": [
      {
        "步骤序号": 1,
        "操作": "配制铁氰化物溶液",
        "试剂/对象": "K4Fe(CN)6.3H2O",
        "参数": "6 mmol in 200 mL deionized water"
      },
      {
        "步骤序号": 2,
        "操作": "配制锰盐络合溶液",
        "试剂/对象": "MnSO4.H2O + potassium citrate",
        "参数": "6 mmol MnSO4.H2O + 8 g potassium citrate in 200 mL deionized water"
      },
      {
        "步骤序号": 3,
        "操作": "缓慢混合",
        "试剂/对象": "将 MnSO4 溶液加入 K4Fe(CN)6 溶液",
        "参数": "缓慢加入"
      },
      {
        "步骤序号": 4,
        "操作": "搅拌反应",
        "试剂/对象": "混合体系",
        "参数": "60 C; 12 h"
      },
      {
        "步骤序号": 5,
        "操作": "老化",
        "试剂/对象": "反应产物",
        "参数": "60 C; 24 h"
      },
      {
        "步骤序号": 6,
        "操作": "离心与洗涤",
        "试剂/对象": "白色沉淀",
        "参数": "用去离子水和酒精各洗涤 3 次"
      },
      {
        "步骤序号": 7,
        "操作": "真空干燥",
        "试剂/对象": "KMnF 产物",
        "参数": "80 C; duration not explicitly stated"
      }
    ]
  },
  "3. 性能": [
    {

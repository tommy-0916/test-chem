{
  "文献题目": "Building aqueous K-ion batteries for energy storage",
  "普鲁士蓝样品": {
    "样品名称": "KFeMnHCF-3565",
    "化学式": "K1.85Fe0.33Mn0.67[Fe(CN)6]0.98·0.77H2O"
  },
  "1. 解决的问题": "该文主要解决水系全钾离子电池中正极、负极和电解液难以同时匹配的问题，尤其是 PBA 正极容量与循环寿命难以兼顾。作者针对 Mn 富集 PBA 在循环中的相变、Jahn-Teller 畸变以及稀电解液中的溶解问题，通过 Fe 取代和 22 M KCF3SO3 水盐电解液协同优化。目标是同时提升倍率性能、循环稳定性和整电池能量密度。",
  "2. 具体的合成步骤": {
    "描述性总结": "作者采用饱和 KCl 介质中的简单沉淀法制备 KxFeyMn1-y[Fe(CN)6]w·zH2O 系列样品。先将 2 mmol K4Fe(CN)6·3H2O 溶于 100 mL 饱和 KCl 溶液中，再将 FeSO4·7H2O 和 MnSO4·H2O 按对应比例溶于 80 mL 饱和 KCl 溶液中。然后将金属盐溶液缓慢滴加到铁氰化物溶液中，在 60 °C 下磁搜拌 12 h，反应后离心、用去离子水洗涤，最后在 80 °C 空气中干燥 12 h。正文未明确给出 KFeMnHCF-3565 对应 FeSO4 和 MnSO4 的精确投料摩尔数。",
    "参数列表": [
      {
        "步骤序号": 1,
        "操作": "配制铁氰化物溶液",
        "试剂/对象": "K4Fe(CN)6·3H2O",
        "参数": "2 mmol?100 mL 饱和 KCl 溶液",
        "来源": "正文 Methods 1041-1045 行"
      },
      {
        "步骤序号": 2,
        "操作": "配制 Fe/Mn 金属盐溶液",
        "试剂/对象": "FeSO4·7H2O + MnSO4·H2O",
        "参数": "80 mL 饱和 KCl 溶液；精确比例未明确给出",
        "来源": "正文 Methods 1043-1045 行"
      },
      {
        "步骤序号": 3,
        "操作": "滴加反应",
        "试剂/对象": "将金属盐溶液加入铁氰化物溶液",
        "参数": "60 °C；磁搜拌；12 h",
        "来源": "正文 Methods 1044-1046 行"
      },
      {
        "步骤序号": 4,
        "操作": "固液分离与洗涤",
        "试剂/对象": "离心后洗涤沉淀",
        "参数": "去离子水；洗涤次数未明确给出",
        "来源": "正文 Methods 1046-1047 行"
      },
      {
        "步骤序号": 5,
        "操作": "干燥",
        "试剂/对象": "洗涤后的产物",
        "参数": "80 °C；空气气氛；12 h",
        "来源": "正文 Methods 1047-1048 行"
      }
    ]
  },
  "3. 性能": [
    {

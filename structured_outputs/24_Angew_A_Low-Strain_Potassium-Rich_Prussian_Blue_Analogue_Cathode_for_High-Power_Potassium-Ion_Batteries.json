{
  "文献题目": "A Low-Strain Potassium-Rich Prussian Blue Analogue Cathode for High Power Potassium-Ion Batteries",
  "1. 解决的问题": "该文针对普鲁士蓝类 K 离子正极在充放电过程中局部应变较大、相变动力学较慢从而限制高功率输出的问题。作者构建富 K 且低应变的 PBA 正极，目标是同时降低电化学极化、提升倍率性能并保持结构长期稳定。",
  "2. 具体的合成步骤": {
    "描述性总结": "作者采用柠檬酸三钃辅助的液相共沉淀法制备富 K 的 PBA 正极。先将 4 mmol K3C6H5O7.H2O 和 0.2 g NiCl2.6H2O 溶于 50 mL 水中形成 A 液，再将 1 mmol K4Fe(CN)6.3H2O 溶于另外 50 mL 水中形成 B 液。将 B 液缓慢滴加到 A 液后搅拌 5 min，然后静置老化 48 h，最后离心、去离子水洗涤 3 次，并在 80°C 真空条件下干燥 12 h。",
    "参数列表": [
      {
        "步骤序号": 1,
        "操作": "配制 A 液",
        "试剂/对象": "K3C6H5O7.H2O + NiCl2.6H2O",
        "参数": "4 mmol K3C6H5O7.H2O + 0.2 g NiCl2.6H2O in 50 mL water"
      },
      {
        "步骤序号": 2,
        "操作": "配制 B 液",
        "试剂/对象": "K4Fe(CN)6.3H2O",
        "参数": "1 mmol in 50 mL water"
      },
      {
        "步骤序号": 3,
        "操作": "缓慢滴加",
        "试剂/对象": "将 B 液加入 A 液",
        "参数": "stir 5 min after addition"
      },
      {
        "步骤序号": 4,
        "操作": "老化",
        "试剂/对象": "反应体系",
        "参数": "48 h"
      },
      {
        "步骤序号": 5,
        "操作": "离心与洗涤",
        "试剂/对象": "产物沉淀",
        "参数": "去离子水洗涤 3 次"
      },
      {
        "步骤序号": 6,
        "操作": "真空干燥",
        "试剂/对象": "产物",
        "参数": "80 C; 12 h"
      }
    ]
  },
  "3. 性能": [
    {
      "序号": 1,
      "指标": "放电比容量",

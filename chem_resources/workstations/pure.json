  "station_function": {
    "primary_purpose": "用于样品的离心纯化和分离处理",
    "detail_description": "离心纯化工作站主要用于对各类混合物进行离心、清洗或纯化处理。它采用机械臂、震荡机及离心机高度耦合的方式，实现从进样、清洗、离心或纯化的完全无人操作。在化学、生物等实验中，目标产物往往需要进行固相和液相分离，经过清洗得到无杂质的样品，离心纯化工作站能够高效的进行分离获取需要的目标产物。",
    "workflow_position": "middle",
    "available_operations": {
      "最新纯化离心流程": "使用最新的纯化离心流程进行样品分离",

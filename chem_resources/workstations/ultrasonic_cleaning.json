  "station_function": {
    "primary_purpose": "用于样品的超声波清洗和预处理",
    "detail_description": "超声波处理工作站利用超声波的空化效应、机械效应等对样品进行处理。超声波在液体中传播时产生的微小气泡的形成和破裂，能够产生强大的冲击力和剪切力，可用于细胞破碎、样品分散、加速化学反应等。在生物、化学等实验中有着广泛应用。例如在生物样品处理中，可用于提取细胞内的蛋白质、核酸等生物大分子；在化学合成中，能够加速反应速率，提高反应产率。",
    "workflow_position": "front",
    "available_operations": {
      "超声清洗": "进行超声波清洗处理",
      "强力清洗": "高功率强力清洗"
    }
  },

{
  "schema": "chemistry-conventions/v1",
  "comment": "受控 chemistry convention 规则库。规则是 deterministic semantic expansion:只展开状态/相/谱系/lineage,绝不展开数值(numeric_generation_allowed 恒为 false,代码层同样禁止)。规则命中由 operation 文本 + 意图文本 + 输入状态共同决定;同一操作的不同意图命中不同规则(例:collect precipitate vs collect supernatant)。",
  "rules": [
    {
      "rule_id": "CENTRIFUGE_COLLECT_PRECIPITATE_V1",
      "version": "1.0.0",
      "operation": "centrifugation",
      "preconditions": {
        "operation_patterns": ["centrifug", "离心"],
        "intent_patterns": ["collect precipitate", "collect the precipitate", "collect pellet", "保留沉淀", "收集沉淀", "离心收集沉淀", "留固"],
        "input_states": ["suspension", "retained_wet_solid", "washed_wet_solid"],
        "retained_object_patterns": ["precipitate", "pellet", "沉淀"]
      },
      "allowed_input_states": ["suspension", "retained_wet_solid", "washed_wet_solid"],
      "output_states": ["retained_wet_solid", "supernatant"],
      "retained_output": "retained_wet_solid",
      "discard_outputs": ["supernatant"],
      "lineage_effect": {
        "relation_type": "state_change_of",
        "lineage_preserved": true,
        "parent_role": "input",
        "child_role": "retained_output"
      },
      "numeric_generation_allowed": false
    },
    {
      "rule_id": "CENTRIFUGE_COLLECT_SUPERNATANT_V1",

      },
      "allowed_input_states": ["suspension", "retained_wet_solid", "washed_wet_solid"],
      "output_states": ["supernatant", "retained_wet_solid"],
      "retained_output": "supernatant",
      "discard_outputs": ["retained_wet_solid"],

# Required. Do not commit your real token.
WEB_ACCESS_TOKEN=replace-with-a-long-random-access-code

# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=https://echo-hyt.github.io

# Conservative defaults for a fragile server.
MAX_UPLOAD_MB=20
MAX_INSTRUCTION_CHARS=6000
RATE_LIMIT_PER_MINUTE=3
MAX_CONCURRENT_TASKS=1
AGENT_TIMEOUT_SECONDS=180

# Set to 1 only when Nginx is correctly forwarding the real client IP.
TRUST_PROXY_HEADERS=0

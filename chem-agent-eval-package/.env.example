# Chem Agent LLM configuration. Replace placeholders with your own values.
REFINER_LLM_MODEL_NAME=gpt-5.6-sol
REFINER_LLM_ENDPOINT_URL=https://anyrouter.top/v1
REFINER_LLM_API_KEY=REPLACE_WITH_YOUR_KEY
REFINER_LLM_WIRE_API=codex_responses
REFINER_LLM_REASONING_EFFORT=xhigh
REFINER_LLM_TIMEOUT_SECONDS=7200

# Optional independent schema-reviewer keys. These do not become Chem Agent
# task inputs; they are used only after the black-box campaign has finished.
# JSON array and comma-separated forms are both supported.
CHEM_AGENT_SCHEMA_REVIEW_API_KEYS=["REPLACE_WITH_KEY_1","REPLACE_WITH_KEY_2"]

# Copy these names into the Chem Agent repository .env or export them in the
# shell. Never put a real key in this distributable package.
REFINER_LLM_MODEL_NAME=REPLACE_WITH_MODEL_NAME
REFINER_LLM_ENDPOINT_URL=https://provider.example/v1
REFINER_LLM_API_KEY=REPLACE_WITH_API_KEY
REFINER_LLM_WIRE_API=codex_responses
REFINER_LLM_REASONING_EFFORT=xhigh
REFINER_LLM_TIMEOUT_SECONDS=7200
REFINER_LLM_MAX_RETRIES=8

# Optional campaign key pool. JSON-array and comma-separated forms are
# supported. Keys are assigned to whole black-box cases, never recorded.
CHEM_AGENT_EVAL_API_KEYS=["REPLACE_WITH_KEY_1","REPLACE_WITH_KEY_2"]

# Optional independent schema-review key pool.
CHEM_AGENT_SCHEMA_REVIEW_API_KEYS=["REPLACE_WITH_REVIEW_KEY_1"]

# Copy this file to .env for local use. Never put real credentials in this template.

# Primary OpenAI-compatible LLM backend
REFINER_LLM_MODEL_NAME=
REFINER_LLM_ENDPOINT_URL=
REFINER_LLM_API_KEY=
REFINER_LLM_MODEL_PROVIDER=
REFINER_LLM_WIRE_API=chat
REFINER_LLM_REASONING_EFFORT=high
REFINER_LLM_TIMEOUT_SECONDS=180
REFINER_LLM_MAX_RETRIES=3

# Optional research-agent fallback backends
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as a Gemini key alias.
GOOGLE_API_KEY=

# Scholarly metadata and open-access PDF resolution
SEMANTIC_SCHOLAR_API_KEY=
# S2_API_KEY is accepted as a compatibility alias.
S2_API_KEY=
CROSSREF_MAILTO=
OPENALEX_MAILTO=
UNPAYWALL_EMAIL=
CORE_API_KEY=
NCBI_API_KEY=

# General web search and page reading
# Multiple Tavily keys may be comma-separated for automatic rotation.
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
SEARXNG_BASE_URL=
JINA_API_KEY=

# Optional laboratory metadata lookup. Real dispatch remains blocked by design.
AICHEM_CLOUD_GATEWAY=
AICHEM_APP_TOKEN=

# Optional defaults for research runs
RESEARCH_ONLINE_LITERATURE=0
RESEARCH_WEB_SEARCH=0
RESEARCH_EXTERNAL_TOOL_MAX_ROUNDS=2
